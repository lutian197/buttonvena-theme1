<div
  style="
    display: grid;
    grid-template-columns: repeat({{ block.settings.columns }}, 1fr);
    column-gap: {{ block.settings.column_gap }}px;
    row-gap: {{ block.settings.row_gap }}px;
  "
  {{ block.shopify_attributes }}
>
  {% for sub_block in block.blocks %}
    {% render sub_block %}
  {% endfor %}
</div>

{% schema %}
{
  "name": "t:names.banner_group",
  "tag": null,
  "blocks": [{ "type": "default-banner" }],
  "settings": [
    {
      "type": "range",
      "id": "columns",
      "label": "列数",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 1
    },
    {
      "type": "range",
      "id": "column_gap",
      "label": "列间距 (px)",
      "min": 8,
      "max": 48,
      "step": 2,
      "default": 8,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "row_gap",
      "label": "行间距 (px)",
      "min": 8,
      "max": 48,
      "step": 2,
      "default": 8,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "checkbox",
      "id": "background",
      "label": "t:settings.background",
      "default": false
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "alpha": true,
      "default": "#00000026",
      "visible_if": "{{ block.settings.background }}"
    }
  ],
  "presets": [
    {
      "name": "t:names.banner_group",
      "category": "t:categories.layout"
    }
  ]
}
{% endschema %}
