<div
  class="default-banner"
  style="gap: {{ block.settings.icon_text_gap }}px; justify-content: {{ block.settings.horizontal_alignment }};"
  {{ block.shopify_attributes }}
>
  {% if block.settings.icon != blank %}
    <img
      src="{{ block.settings.icon | image_url: width: block.settings.icon_width, height: block.settings.icon_height, crop: 'center' }}"
      alt="{{ block.settings.icon.alt | escape }}"
      width="{{ block.settings.icon_width }}"
      height="{{ block.settings.icon_height }}"
      style="width: {{ block.settings.icon_width }}px; height: {{ block.settings.icon_height }}px; flex-shrink: 0;"
      loading="lazy"
    >
  {% endif %}

  {% if block.settings.metafield_key != blank %}
    {% assign banner_text = product.metafields.custom[block.settings.metafield_key].value
      | default: block.settings.text
    %}
  {% else %}
    {% assign banner_text = block.settings.text %}
  {% endif %}

  {% if banner_text != blank %}
    <span style="font-size: {{ block.settings.font_size }}; font-weight: {{ block.settings.font_weight }};">
      {{ banner_text }}
    </span>
  {% endif %}
</div>

{% stylesheet %}
  .default-banner {
    display: flex;
    align-items: center;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.default_banner",
  "settings": [
    {
      "type": "range",
      "id": "icon_text_gap",
      "label": "t:settings.gap",
      "min": 0,
      "max": 32,
      "step": 2,
      "default": 8,
      "unit": "px"
    },
    {
      "type": "select",
      "id": "horizontal_alignment",
      "label": "t:settings.alignment",
      "options": [
        {
          "value": "flex-start",
          "label": "t:options.left"
        },
        {
          "value": "center",
          "label": "t:options.center"
        },
        {
          "value": "flex-end",
          "label": "t:options.right"
        }
      ],
      "default": "flex-start"
    },
    {
      "type": "image_picker",
      "id": "icon",
      "label": "t:settings.icon"
    },
    {
      "type": "range",
      "id": "icon_width",
      "label": "t:settings.width",
      "min": 8,
      "max": 64,
      "step": 2,
      "default": 16,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "icon_height",
      "label": "t:settings.height",
      "min": 8,
      "max": 64,
      "step": 2,
      "default": 16,
      "unit": "px"
    },
    {
      "type": "text",
      "id": "text",
      "label": "t:settings.text",
      "default": "text"
    },
    {
      "type": "text",
      "id": "metafield_key",
      "label": "Metafield key",
      "placeholder": "Product metafield definitions"
    },
    {
      "type": "select",
      "id": "font_size",
      "label": "t:settings.size",
      "options": [
        {
          "value": "",
          "label": "t:options.default"
        },
        {
          "value": "0.625rem",
          "label": "10px"
        },
        {
          "value": "0.75rem",
          "label": "12px"
        },
        {
          "value": "0.875rem",
          "label": "14px"
        },
        {
          "value": "1rem",
          "label": "16px"
        },
        {
          "value": "1.125rem",
          "label": "18px"
        },
        {
          "value": "1.25rem",
          "label": "20px"
        },
        {
          "value": "1.5rem",
          "label": "24px"
        }
      ],
      "default": "0.75rem"
    },
    {
      "type": "select",
      "id": "font_weight",
      "label": "t:settings.font_weight",
      "options": [
        { "value": "400", "label": "t:options.regular" },
        { "value": "600", "label": "t:options.semibold" }
      ],
      "default": "400"
    }
  ],
  "presets": [
    {
      "name": "t:names.default_banner",
      "category": "t:categories.custom"
    }
  ]
}
{% endschema %}
