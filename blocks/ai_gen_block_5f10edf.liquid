{% doc %}
  @prompt
    In the Contact Us page, make two specific buttons appear side by side on the same row instead of stacking vertically. The page content is rendered inside the main-page template which lays out all content vertically. Use CSS flexbox to wrap the buttons in a flex container with flex-direction row, gap, and mobile responsive wrapping. Do not change any other layout or styling on the page.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
    .ai-button-row-{{ ai_gen_id }} {
      display: block;
      width: {{ block.settings.desktop_width_percent }}%;
      max-width: 100%;
    }

    .ai-button-wrapper {
      flex: 1;
    }

    .ai-button-wrapper-1 {
      text-align: right;
    }

    .ai-button-row-container-{{ ai_gen_id }} {
      display: flex;
      flex-direction: row;
      gap: var(--gap-md);
      align-items: center;
      justify-content: {{ block.settings.alignment }};
      flex-wrap: wrap;
    }

    .ai-button-row-button-{{ ai_gen_id }} {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: {{ block.settings.button_padding_vertical }}px {{ block.settings.button_padding_horizontal }}px;
      text-decoration: none;
      border: none;
      cursor: pointer;
      transition: all 0.3s ease;
      font-size: {{ block.settings.button_font_size }}px;
      border-radius: {{ block.settings.button_border_radius }}px;
      text-align: center;
    }

    .ai-button-row-button-primary-{{ ai_gen_id }} {
      background-color: {{ block.settings.button_1_bg_color }};
      color: {{ block.settings.button_1_text_color }};
    }

    .ai-button-row-button-primary-{{ ai_gen_id }}:hover {
      background-color: {{ block.settings.button_1_hover_bg_color }};
      color: {{ block.settings.button_1_hover_text_color }};
    }

    .ai-button-row-button-secondary-{{ ai_gen_id }} {
      background-color: {{ block.settings.button_2_bg_color }};
      color: {{ block.settings.button_2_text_color }};
    }

    .ai-button-row-button-secondary-{{ ai_gen_id }}:hover {
      background-color: {{ block.settings.button_2_hover_bg_color }};
      color: {{ block.settings.button_2_hover_text_color }};
    }

    @media screen and (max-width: 749px) {
    .ai-button-row-{{ ai_gen_id }} {
      width: 100%;
    }

    .ai-button-row-container-{{ ai_gen_id }} {
      {% if block.settings.mobile_stack %}
        flex-direction: column;
      {% endif %}
    }

    .ai-button-row-button-{{ ai_gen_id }} {
      {% if block.settings.mobile_full_width %}
        width: 100%;
      {% endif %}
    }
  }
{% endstyle %}

<div class="ai-button-row-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-button-row-container-{{ ai_gen_id }}">
    {% if block.settings.button_1_text != blank %}
      <div class="ai-button-wrapper ai-button-wrapper-1">
        <a
          href="{{ block.settings.button_1_link }}"
          class="ai-button-row-button-{{ ai_gen_id }} ai-button-row-button-primary-{{ ai_gen_id }}"
        >
          {{ block.settings.button_1_text }}
        </a>
      </div>
    {% endif %}

    {% if block.settings.button_2_text != blank %}
      <div class="ai-button-wrapper">
        <a
          href="{{ block.settings.button_2_link }}"
          class="ai-button-row-button-{{ ai_gen_id }} ai-button-row-button-secondary-{{ ai_gen_id }}"
        >
          {{ block.settings.button_2_text }}
        </a>
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Button row",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "options": [
        {
          "value": "flex-start",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "flex-end",
          "label": "Right"
        }
      ],
      "default": "flex-start"
    },
    {
      "type": "header",
      "content": "Mobile"
    },
    {
      "type": "checkbox",
      "id": "mobile_stack",
      "label": "Stack buttons vertically on mobile",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "mobile_full_width",
      "label": "Full width buttons on mobile",
      "default": true
    },
    {
      "type": "header",
      "content": "Button 1"
    },
    {
      "type": "text",
      "id": "button_1_text",
      "label": "Text",
      "default": "Button 1"
    },
    {
      "type": "url",
      "id": "button_1_link",
      "label": "Link"
    },
    {
      "type": "color",
      "id": "button_1_bg_color",
      "label": "Background color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "button_1_text_color",
      "label": "Text color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "button_1_hover_bg_color",
      "label": "Hover background color",
      "default": "#333333"
    },
    {
      "type": "color",
      "id": "button_1_hover_text_color",
      "label": "Hover text color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Button 2"
    },
    {
      "type": "text",
      "id": "button_2_text",
      "label": "Text",
      "default": "Button 2"
    },
    {
      "type": "url",
      "id": "button_2_link",
      "label": "Link"
    },
    {
      "type": "color",
      "id": "button_2_bg_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "button_2_text_color",
      "label": "Text color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "button_2_hover_bg_color",
      "label": "Hover background color",
      "default": "#f5f5f5"
    },
    {
      "type": "color",
      "id": "button_2_hover_text_color",
      "label": "Hover text color",
      "default": "#000000"
    },
    {
      "type": "header",
      "content": "Button style"
    },
    {
      "type": "range",
      "id": "button_font_size",
      "label": "Font size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "button_padding_vertical",
      "label": "Vertical padding",
      "min": 8,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "button_padding_horizontal",
      "label": "Horizontal padding",
      "min": 16,
      "max": 48,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "button_border_radius",
      "label": "Border radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Button row"
    }
  ]
}
{% endschema %}
