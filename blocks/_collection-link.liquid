{%- doc -%}
  Renders a collection link block.

  @param {number} index
  @param {boolean} [current]
  @param {boolean} [image_only]
{%- enddoc -%}

{% unless current %}
  {% assign loading = 'lazy' %}
{% endunless %}

{% liquid
  assign onboarding = false
  if closest.collection == empty
    assign onboarding = true
  endif
%}

{% if block.settings.show_count %}
  {% assign count_num = closest.collection.all_products_count %}
  {% if onboarding %}
    {% assign count_num = 5 %}
  {% endif %}
  {%- capture count -%}
    &nbsp;<sup class="collection-links__count">{{ count_num }}</sup>
  {%- endcapture -%}
{% endif %}

{% liquid
  assign collection_image = closest.collection.image | default: closest.collection.featured_image
  if collection_image == blank and closest.collection.products.first != blank
    assign collection_image = closest.collection.products.first.featured_image
  endif
  comment
    无图片则不显示该系列
  endcomment
%}

{% if collection_image != blank %}
  <a
    href="{{ closest.collection.url }}"
    class="collection-links__link"
    ref="links[]"
    aria-current="{{ current }}"
    {{ block.shopify_attributes }}
  >
    <span class="collection-links__link-content">
      <span class="collection-links__link-image">
        {{ collection_image | image_url: width: 80, height: 80 | image_tag: loading: loading }}
      </span>

      <span class="collection-links__link-title">
        {{ closest.collection.title }}
      </span>
    </span>
  </a>
{% endif %}

{% stylesheet %}
  .collection-links__link {
    display: flex;
    color: inherit;
    text-decoration: none;
    text-wrap: pretty;

    [layout='spotlight'] & {
      opacity: var(--disabled-opacity);
    }

    &[aria-current='true'] {
      .collection-links__link-image {
        border-color: rgba(0, 0, 0, 0.8);
      }
    }
  }

  .collection-links__link-content {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 8px;
    width: 100%;
  }

  @media (hover: hover) {
    .collection-links__link:hover .collection-links__link-image {
      border-color: rgba(0, 0, 0, 0.5);
    }
  }

  .collection-links__link-image {
    padding: 4px;
    width: 90px;
    height: 90px;
    border-radius: 50%;
    border: 2px solid rgba(0, 0, 0, 0.2);
    transition: all 0.3s ease;
    @media (max-width: 749px) {
      width: 66px;
      height: 66px;
    }

    img {
      width: 80px;
      height: 80px;
      object-fit: cover;
      border-radius: 50%;
      @media (max-width: 749px) {
        width: 56px;
        height: 56px;
      }
    }
  }

  .collection-links__link-title {
    font-weight: 600;
    font-size: 14px;
    text-align: center;
  }

  .collection-links__count {
    font-size: 0.5em;
    opacity: var(--disabled-opacity);
    font-weight: var(--font-paragraph--weight);
  }

  .collection-links__image {
    align-items: center;
    justify-content: center;

    &:not([hidden]) {
      display: flex;
    }

    &[reveal] {
      --offset: 15px;

      position: fixed;
      top: 0;
      left: 0;
      z-index: var(--layer-temporary);
      display: block;
      translate: calc(var(--x) + var(--offset)) calc(var(--y) + var(--offset));
      pointer-events: none;
      width: auto;

      image-block {
        --image-height-basis: 5rem;

        height: var(--image-height);
      }
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.collection",
  "tag": null,
  "settings": [
    {
      "type": "paragraph",
      "content": "t:content.resource_reference_collection_card"
    },
    {
      "type": "checkbox",
      "id": "show_count",
      "label": "t:settings.show_count",
      "default": true
    }
  ]
}
{% endschema %}
