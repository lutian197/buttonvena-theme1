{%- doc -%}
  Renders a quick add component for selected color variant.

  @param {object} product - The product object
  @param {string} section_id - The section ID
  @param {object} [block] - The block object
  @param {number} [default_variant_id] - Default variant ID to use (if not provided, uses first color variant)
  @param {boolean} [listen_to_color_changes] - Whether to listen to color selection changes (default: true)
{%- enddoc -%}

{% liquid
  assign product_form_id = 'QuickAddColor-ProductForm-' | append: product.id | append: '-' | append: block.id
  assign add_to_cart_text = 'actions.add' | t
  assign listen_to_color_changes = listen_to_color_changes | default: true

  # Get variant to use - prioritize default_variant_id parameter
  assign variant_to_use = null

  if default_variant_id != blank
    # Use the provided default variant ID
    for variant in product.variants
      if variant.id == default_variant_id
        assign variant_to_use = variant
        break
      endif
    endfor
  endif

  # If no variant found from parameter, find first color variant
  if variant_to_use == null
    assign variant_to_use = product.selected_or_first_available_variant
    assign color_option = null

    # Find color option
    for option in product.options_with_values
      assign option_name_lower = option.name | downcase
      if option_name_lower contains 'color' or option_name_lower contains 'colour'
        assign color_option = option
        break
      endif
    endfor

    # If no color option found, use first option if it has swatches
    if color_option == null
      for option in product.options_with_values
        assign swatch_count = option.values | map: 'swatch' | compact | size
        if swatch_count > 0
          assign color_option = option
          break
        endif
      endfor
    endif

    # Use first color variant if available
    if color_option != null and color_option.values.size > 0
      assign variant_to_use = color_option.values.first.variant
    endif
  endif

  if variant_to_use.available
    assign can_add_to_cart = true
  else
    assign can_add_to_cart = false
  endif
%}

<quick-add-color-component
  class="quick-add color-{{ settings.quick_add_color_scheme }}"
  data-product-id="{{ product.id }}"
  data-default-variant-id="{{ variant_to_use.id }}"
  data-listen-to-color-changes="{{ listen_to_color_changes }}"
>
  <product-form-component
    data-section-id="{{ section_id }}"
    data-product-id="{{ product.id }}"
    on:submit="/handleSubmit"
    class="quick-add__product-form-component quick-add__product-form-component--single-variant"
  >
    <div
      class="visually-hidden"
      aria-live="assertive"
      role="status"
      aria-atomic="true"
      ref="liveRegion"
    ></div>
    {%- form 'product', product, id: product_form_id, novalidate: 'novalidate', data-type: 'add-to-cart-form' -%}
      <input
        type="hidden"
        name="id"
        ref="variantId"
        value="{{ variant_to_use.id }}"
        {% if variant_to_use.available == false %}
          disabled
        {% endif %}
      >
      <input
        type="hidden"
        name="quantity"
        value="{% if variant_to_use.quantity_rule.min %}{{ variant_to_use.quantity_rule.min }}{% else %}1{% endif %}"
      >
      {% render 'add-to-cart-button',
        add_to_cart_text: add_to_cart_text,
        class: 'button quick-add__button quick-add__button--add',
        can_add_to_cart: can_add_to_cart,
        icon_only_on_mobile: true,
        product: product
      %}
    {%- endform -%}
  </product-form-component>
</quick-add-color-component>

<script>
  (function () {
    class QuickAddColorComponent extends HTMLElement {
      constructor() {
        super();
        this.productFormComponent = this.querySelector('product-form-component');
        this.variantIdInput = this.querySelector('input[name="id"]');
        this.quantityInput = this.querySelector('input[name="quantity"]');
        this.productId = this.dataset.productId;
        this.defaultVariantId = this.dataset.defaultVariantId;
        this.listenToColorChanges = this.dataset.listenToColorChanges !== 'false';
        this.gallery = null;
        this.init();
      }

      connectedCallback() {
        // Wait for gallery to be initialized
        this.findGallery();

        // Also try to find gallery after DOM is fully loaded
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', () => this.findGallery());
        }
      }

      findGallery() {
        // Only look for gallery if we should listen to color changes
        if (!this.listenToColorChanges) {
          // Use default variant ID if provided
          if (this.defaultVariantId) {
            this.updateVariantId(this.defaultVariantId);
          }
          return;
        }

        // Find the gallery element by product ID
        const galleries = document.querySelectorAll('.product-gallery-with-colors');
        this.gallery = Array.from(galleries).find((g) => g.dataset.productId === this.productId);

        if (this.gallery && !this.gallery.dataset.quickAddColorInitialized) {
          this.gallery.dataset.quickAddColorInitialized = 'true';
          this.setupListeners();
          this.setInitialVariant();
        } else if (!this.gallery) {
          // Retry after a short delay if gallery not found yet (max 10 retries)
          if (!this._retryCount) this._retryCount = 0;
          if (this._retryCount < 10) {
            this._retryCount++;
            setTimeout(() => this.findGallery(), 100);
          } else {
            // If gallery not found after retries, use default variant
            if (this.defaultVariantId) {
              this.updateVariantId(this.defaultVariantId);
            }
          }
        }
      }

      setupListeners() {
        // Listen for custom color variant change event
        this.gallery.addEventListener('color-variant-changed', (e) => {
          const variantId = e.detail.variantId;
          if (variantId) {
            this.updateVariantId(variantId);
          }
        });

        // Also listen for click events as fallback
        this.gallery.addEventListener('click', (e) => {
          const colorThumb = e.target.closest('.product-gallery-with-colors__color-thumb');
          if (colorThumb && colorThumb.dataset.variantId) {
            // Use setTimeout to ensure this runs after the custom event
            setTimeout(() => {
              this.updateVariantId(colorThumb.dataset.variantId);
            }, 0);
          }
        });

        // Also listen for active state changes
        const observer = new MutationObserver(() => {
          this.setInitialVariant();
        });

        observer.observe(this.gallery, {
          attributes: true,
          attributeFilter: ['class'],
          subtree: true,
        });
      }

      setInitialVariant() {
        if (!this.gallery) {
          // If no gallery, use default variant ID
          if (this.defaultVariantId) {
            this.updateVariantId(this.defaultVariantId);
          }
          return;
        }

        const activeThumb = this.gallery.querySelector('.product-gallery-with-colors__color-thumb--active');
        if (activeThumb && activeThumb.dataset.variantId) {
          this.updateVariantId(activeThumb.dataset.variantId);
        } else if (this.defaultVariantId) {
          // Fallback to default variant if no active thumb found
          this.updateVariantId(this.defaultVariantId);
        }
      }

      updateVariantId(variantId) {
        if (!variantId || !this.variantIdInput) return;

        const previousVariantId = this.variantIdInput.value;
        if (previousVariantId === variantId) return;

        // Update variant ID in the hidden input (this is the most important)
        this.variantIdInput.value = variantId;
        this.variantIdInput.setAttribute('value', variantId);

        // Update product form component's variant ID ref (critical for form submission)
        if (this.productFormComponent) {
          // Update the refs if available (this is what ProductFormComponent uses)
          if (this.productFormComponent.refs && this.productFormComponent.refs.variantId) {
            this.productFormComponent.refs.variantId.value = variantId;
            this.productFormComponent.refs.variantId.setAttribute('value', variantId);
          }
        }

        // Also update all inputs with name="id" in the form to be safe
        const form = this.variantIdInput.closest('form');
        if (form) {
          const allVariantInputs = form.querySelectorAll('input[name="id"]');
          allVariantInputs.forEach((input) => {
            input.value = variantId;
            input.setAttribute('value', variantId);
          });
        }

        // Fetch variant data to update availability and quantity
        this.fetchVariantData(variantId);
      }

      async fetchVariantData(variantId) {
        try {
          const url = `/products/${this.productId}?view=variant&variant=${variantId}`;
          const response = await fetch(url);
          if (!response.ok) return;

          const html = await response.text();
          const parser = new DOMParser();
          const doc = parser.parseFromString(html, 'text/html');

          // Update variant availability
          const variantData = doc.querySelector('[data-variant-id]');
          if (variantData) {
            const isAvailable = variantData.dataset.variantAvailable === 'true';
            const addToCartButton = this.querySelector('button[type="submit"]');
            const addToCartComponent = this.querySelector('add-to-cart-component');

            if (addToCartButton) {
              if (isAvailable) {
                addToCartButton.removeAttribute('disabled');
                if (addToCartComponent) {
                  addToCartComponent.enable?.();
                }
              } else {
                addToCartButton.setAttribute('disabled', 'disabled');
                if (addToCartComponent) {
                  addToCartComponent.disable?.();
                }
              }
            }

            // Update quantity if needed
            const minQuantity = variantData.dataset.variantMinQuantity;
            if (minQuantity && this.quantityInput) {
              this.quantityInput.value = minQuantity;
            }
          }
        } catch (error) {
          console.error('Error fetching variant data:', error);
        }
      }

      init() {
        // Initialization handled in connectedCallback
      }
    }

    customElements.define('quick-add-color-component', QuickAddColorComponent);
  })();
</script>

{% stylesheet %}
  /* Quick Add Color - uses same styles as quick-add */
  .quick-add-color-component {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    width: auto;
    height: auto;
    z-index: var(--layer-raised);
    cursor: default;
    pointer-events: none;
  }

  .quick-add-color-component[class*='color-scheme-'] {
    background-color: transparent;
  }

  .quick-add-color-component .quick-add__button {
    display: grid;
    padding: var(--padding-xs);
    align-items: center;
    background-color: var(--color-background);
    color: var(--color-foreground);
    border-color: transparent;
    box-shadow: var(--shadow-popover);
    pointer-events: all;
    position: relative;
    overflow: hidden;
    border-radius: 100px;

    @media screen and (min-width: 750px) {
      padding: var(--padding-xs) var(--padding-sm);
    }
  }

  .quick-add-color-component .quick-add__button .add-to-cart-text {
    gap: 0;
    line-height: 1;
    grid-row: 1 / span 1;
    grid-column: 1 / span 1;
    animation: none;

    @media screen and (min-width: 750px) {
      margin-inline: calc(var(--padding-sm) * -1);
      padding-inline: var(--padding-xs);
    }
  }

  .quick-add-color-component .quick-add__button .add-to-cart-text--added {
    position: relative;
    grid-row: 1 / span 1;
    grid-column: 1 / span 1;
    justify-self: end;
    line-height: 1;

    @media screen and (min-width: 750px) {
      width: 0;
    }
  }

  .quick-add-color-component .quick-add__button .add-to-cart-text__content {
    width: 0;
    opacity: 0;
    transform: translateX(1em);
    transition: width var(--animation-speed) ease-in-out, opacity var(--animation-speed) ease-in-out,
      transform var(--animation-speed) ease-in-out;
    interpolate-size: allow-keywords;
    will-change: width, opacity, transform;
  }

  .quick-add-color-component .quick-add__button.atc-added .add-to-cart-text {
    opacity: 0;
  }

  .quick-add-color-component .quick-add__button.atc-added .add-to-cart-text--added {
    opacity: 1;
    width: auto;

    @supports (width: calc-size(auto, size)) {
      width: calc-size(auto, size);
    }
  }

  .quick-add-color-component .quick-add__button.atc-added .add-to-cart-text {
    animation-name: atc-fade-out;
  }

  .quick-add-color-component .quick-add__button.atc-added .add-to-cart-text--added {
    animation-name: atc-fade-in;
  }

  @container (min-width: 99px) {
    .quick-add-color-component .quick-add__button:is(:focus, :hover) .add-to-cart-text {
      gap: var(--gap-2xs);

      @media screen and (min-width: 750px) {
        margin-inline: 0;
        padding-inline: 0;
      }
    }

    .quick-add-color-component .quick-add__button:is(:focus, :hover) .add-to-cart-text__content {
      width: fit-content;
      opacity: 1;
      transform: translateX(0);
    }
  }

  @keyframes atc-fade-in {
    from {
      opacity: 0;
      transform: translateX(1em);
      position: absolute;
    }

    to {
      opacity: 1;
      transform: translateX(0);
      position: inherit;
    }
  }

  @keyframes atc-fade-out {
    from {
      opacity: 1;
      transform: translateX(0);
      position: inherit;
    }

    to {
      opacity: 0;
      transform: translateX(-1em);
      position: absolute;
    }
  }
{% endstylesheet %}
